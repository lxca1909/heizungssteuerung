[Unit]
Description=Heizungs-Agent (Sunster BLE <-> MQTT)
After=bluetooth.target network-online.target
Wants=bluetooth.target network-online.target

[Service]
Type=simple
User=heizung
WorkingDirectory=/opt/heizungssteuerung/agent
EnvironmentFile=/opt/heizungssteuerung/agent/.env
ExecStart=/opt/heizungssteuerung/agent/.venv/bin/heater-agent
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
