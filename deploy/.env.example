# Kopieren nach .env (wird nicht eingecheckt). setup.sh füllt die Geheimnisse aus.

# WireGuard-IP des Rootservers (darauf lauscht der MQTT-Broker)
WG_IP=10.8.0.1
# Port, auf dem die WebApp lokal für Caddy erreichbar ist
APP_PORT=8080

SECRET_KEY=
MQTT_PASSWORD=
# Format name:hash – Hash erzeugen: docker compose run --rm app python -m app.hashpw
USERS=

TOPIC_PREFIX=werkstatt
COOKIE_SECURE=true

# Push-Benachrichtigungen (optional), z. B. https://ntfy.sh/<langes-zufaelliges-topic>
NTFY_URL=
NTFY_TOKEN=
