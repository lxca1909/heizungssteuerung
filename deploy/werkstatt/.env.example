# Kopieren nach .env (wird nicht eingecheckt) und ausfüllen: chmod 600 .env
# Werte mit Leerzeichen, $ oder # in einfache Anführungszeichen setzen: MQTT_PASSWORD='ab$c d'

# --- MQTT-Broker auf dem Rootserver (über WireGuard) ---
MQTT_HOST=10.8.0.1
MQTT_PORT=1883
MQTT_USER=werkstatt
# Passwort aus der Ausgabe von deploy/setup.sh auf dem Server
MQTT_PASSWORD=
TOPIC_PREFIX=werkstatt

# --- Heizungen (Adresse aus: python probe/heater_probe.py scan) ---
HEATER_1_NAME="Heizung 1"
HEATER_1_ADDRESS=
HEATER_1_PIN=1234

# HEATER_2_NAME="Heizung 2"
# HEATER_2_ADDRESS=
# HEATER_2_PIN=1234

# --- Optional: Sicherheitsregeln (Standardwerte stehen im Kommentar) ---
# SAFETY_DEFAULT_RUNTIME_MIN=120
# SAFETY_MAX_RUNTIME_MIN=240
# SAFETY_REMINDER_MIN=15
# SAFETY_VOLLGAS_MAX_ROOM_TEMP=30   (aus = keine Grenze)
# SAFETY_CO_OFF_PPM=50
# SAFETY_CO_CLEAR_PPM=20
# SAFETY_CO_SENSOR_REQUIRED=false
# POLL_INTERVAL_S=15
# CO_TOPIC=werkstatt-sensor/sensor/co/state
